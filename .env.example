# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify requires this exact URI in the app dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/callback

CLIENT_ORIGIN=http://127.0.0.1:4200
PORT=4000

# Replace this with a long random value outside local development.
SESSION_SECRET=replace-with-a-long-random-string
